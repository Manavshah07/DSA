if i am destroying the queue then bring start = -1 , end = -1 and currentSize = 0

CODE / IMPLEMENTATION:-
class Q {
    size = 10, int q[size], start = -1, end = -1, currentSize = 0

    // IT IS WORKING FOR O(1)
    push(x) {
        // HERE WE WILL NOT BE ABLE TO PUSH ANY ELEMENT AS CURRENTSIZE HAS REACHED MAXIMUM LIMIT i.e. QUEUE HAS BEEN FULL
        if(currentSize == size)
            print("size has been exceeded");
        
        // IF QUEUE IS EMPTY THEN FIRST WE ARE SETTING OUR START AND END TO 0 AS WE NEED TO PUSH THE ELEMENT 
        if(currentSize == 0) {
            start = 0, end = 0;
        } else {
            // IF THEIR IS ALREADY A ELEMENT IN THE QUEUE THEN WE ARE MOVING END TO THE NEXT POSITION 
            // % size is makes the queue circular
            end = (end + 1) % size;
        }
        // HERE WE ARE STORING THE NEW VALUE INSIDE THE QUEUE AND END TELLS US THAT WHERE THE NEXT ELEMENT HAS TO BE INSERTED
        q[end] = x;
        // AS ELEMENT HAS BEEN INSERTED SO WE ARE INCREMENTING CURRENTSIZE OF THE QUEUE
        currentSize += 1;
    }

    // IT IS WORKING FOR O(1)
    pop() {
        // HERE IT MEANS THAT I HAVE NO ELEMENTS INSIDE THE QUEUE
        if(currentSize == 0)
            print("Queue is empty");


        element = q[start] // I NEED TO REMOVE THE FIRST INSERTED ELEMENT THAT WHY I HAVE WRRITTEN q[start]
        // HERE AS WE HAVE ONLY ONE ELEMENT SO IF WE REMOVE THAT THEN WE WILL DESTROY THE QUEUE FOR DESTROYING JUST POINT START AND END TO -1
        if(currentSize == 1)
            start = end = -1;
        else
            // HERE AS WE REMOVE THE ELMENTS FROM START SO AFTER REMOVAL MY START MOVES TO NEXT ELEMENT  
            start = (start + 1)%size;
        // AS WE REMOVE THE ELEMENT AFTER THAT WE REDUCE THE SIZE OF THE QUEUE
        currentSize = currentSize - 1;
        return element;
    }
    
    // IT IS WORKING FOR O(1)
    top() {
        if(currentSize == 0)
            print("Their is no element present in queue");
        return q[start];
    }

    // IT IS WORKING FOR O(1)
    size() {
        return currentSize;
    }
    TIME COMPLEXITY IS O(1)
    SPACE COMPLEXITY IS O(10) AS SIZE NEEDS TO BE ALREADY FIXED IN ARRAY
}


