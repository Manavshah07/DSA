top()
top = 1
pop() 
temp = top // THE ELEMENT WHERE TOP IS STANDING i.e element 1 SO MY TEMP WILL BE ELEMENT 1
top = top -> next // HERE IT WILL MOVE THE TOP TO NEXT POSITION i.e MY TOP = 3
delete temp // IT WILL REMOVE THE TEMP i.e ELEMENT 1
                4 <-- 2 <-- 3
